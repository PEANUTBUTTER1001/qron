<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          앱 외부(화면 스캔 타일/접근성 서비스) 진입 전용 결과 화면.
          인앱 스캔 결과는 AppNavHost의 Result destination으로 표시된다.
          같은 앱 내부 PendingIntent로만 실행되므로 exported=false.
        -->
        <activity
            android:name=".ScanResultActivity"
            android:exported="false" />
    </application>
</manifest>
